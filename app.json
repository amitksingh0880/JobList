{
  "expo": {
    "name": "Sarkari Naukri",
    "slug": "joblist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sarkarinaukri",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sarkarinaukri.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.sarkarinaukri.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "expo-status-bar": {
        "style": "light"
      },
      "eas": {
        "projectId": "47dc00bb-5d5e-40fe-9cc6-7293f6ad470b"
      }
    },
    "owner": "amit.k.singh"
  }
}
